% \plotframe[<height>]{<caption>} — dashed placeholder to tape/paste a
% printed plot, or to \includegraphics into later.
\newcommand{\plotframe}[2][55mm]{%
  \par\addvspace{6pt}\noindent
  \begin{tikzpicture}
    \draw[aveTeal!55, dashed, line width=0.7pt]
      (0,0) rectangle (\linewidth,#1);
    \node[anchor=north west, inner sep=5pt, text=aveFaint]
      at (0,#1) {\sffamily\fontsize{7}{8}\selectfont\MakeUppercase{#2}};
    \node[text=aveGridStrong] at ($(0,0)!0.5!(\linewidth,#1)$)
      {\sffamily\small affix / \texttt{\textbackslash includegraphics} here};
  \end{tikzpicture}\par\addvspace{6pt}}

