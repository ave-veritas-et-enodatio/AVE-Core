% =====================================================================
%  THE LATTICE  —  diamond-cubic bond-star glyph
% ---------------------------------------------------------------------
%  Engine bond vectors projected down the x 2-fold axis (drop x, keep
%  (y,z) as screen (x,y)):
%     a=(+1,+1,+1) -> (+1,+1) up-right   FRONT (x=+1)
%     b=(+1,-1,-1) -> (-1,-1) down-left  FRONT (x=+1)   => "/" diagonal
%     c=(-1,+1,-1) -> (+1,-1) down-right BACK  (x=-1)
%     d=(-1,-1,+1) -> (-1,+1) up-left    BACK  (x=-1)   => "\" diagonal
%  Front bonds bright/thick, back bonds dim/thin -> 3D depth.
%  Centre node = A-site; outer nodes = B-sublattice (bipartite).
% =====================================================================
% \avebondstar[<unit length in pt>]  — the mark, baseline-aligned.
\newcommand{\avebondstar}[1][6]{%
  \begingroup
  % precompute real pt sizes (must MULTIPLY, not digit-concatenate)
  \pgfmathsetmacro{\wf}{0.17*#1}% front bond width
  \pgfmathsetmacro{\wb}{0.09*#1}% back bond width
  \pgfmathsetmacro{\we}{0.05*#1}% node edge width
  \pgfmathsetmacro{\wc}{0.06*#1}% centre edge width
  \pgfmathsetmacro{\rb}{0.19*#1}% back node radius
  \pgfmathsetmacro{\rf}{0.25*#1}% front node radius
  \pgfmathsetmacro{\rk}{0.32*#1}% centre node radius
  \pgfmathsetmacro{\rh}{0.46*#1}% halo radius
  \begin{tikzpicture}[x=#1 pt, y=#1 pt, baseline=-0.6ex,
        line cap=round, line join=round]
    % back bonds ("\"): dim+thin
    \draw[aveBond!45, line width=\wb pt] (0,0) -- (-1,1);
    \draw[aveBond!45, line width=\wb pt] (0,0) -- (1,-1);
    % back nodes (B-sublattice): hollow ring
    \foreach \p in {(-1,1),(1,-1)}{%
      \fill[avePaper] \p circle (\rb pt);
      \draw[aveNodeEdge!75, line width=\we pt] \p circle (\rb pt);}
    % front bonds ("/"): bright+thick
    \draw[aveBond, line width=\wf pt] (0,0) -- (1,1);
    \draw[aveBond, line width=\wf pt] (0,0) -- (-1,-1);
    % front nodes (B-sublattice): solid, crisp
    \foreach \p in {(1,1),(-1,-1)}{%
      \fill[aveNode] \p circle (\rf pt);
      \draw[aveNodeEdge, line width=\we pt] \p circle (\rf pt);}
    % centre node (A-site): halo + solid, largest
    \fill[aveNode!22] (0,0) circle (\rh pt);
    \fill[aveNode] (0,0) circle (\rk pt);
    \draw[aveNodeEdge, line width=\wc pt] (0,0) circle (\rk pt);
  \end{tikzpicture}%
  \endgroup}

% \avewordmark — "AVE" monogram + expansion, sans, brand-coloured.
\newcommand{\avewordmark}{%
  {\sffamily\bfseries
   \textcolor{aveHead}{A}\textcolor{aveTeal}{V}\textcolor{aveHead}{E}%
   \hspace{0.5em}\textcolor{aveInk}{\fontsize{7}{8}\selectfont
   \MakeUppercase{Applied Vacuum Engineering}}}}

% \avelogo — bond-star + wordmark, lockup for headers / title.
\newcommand{\avelogo}[1][7]{\raisebox{-0.35ex}{\avebondstar[#1]}\;\avewordmark}

% \avelatticemark[<unit>] — larger cover motif: a diamond-lattice cell.
% Central A-site, its 4 B neighbours, and a 2nd A-shell, all bonds along
% the two diagonal screen directions (the projected <111> bond set), so
% the figure tiles as a coherent lattice patch.  "/" bonds bright (front),
% "\" bonds dim (back); A-sites solid, B-sites hollow (bipartite).
\newcommand{\avelatticemark}[1][24]{%
  \begingroup
  \pgfmathsetmacro{\wf}{0.12*#1}% front bond
  \pgfmathsetmacro{\wb}{0.07*#1}% back bond
  \pgfmathsetmacro{\web}{0.035*#1}% B-node edge
  \pgfmathsetmacro{\wea}{0.04*#1}% A-node edge
  \pgfmathsetmacro{\wec}{0.05*#1}% centre edge
  \pgfmathsetmacro{\rb}{0.15*#1}% B-node radius
  \pgfmathsetmacro{\ra}{0.17*#1}% A-node radius
  \pgfmathsetmacro{\rk}{0.24*#1}% centre radius
  \pgfmathsetmacro{\rh}{0.34*#1}% halo radius
  \begin{tikzpicture}[x=#1 pt, y=#1 pt, line cap=round, line join=round]
    % dim "\"-direction bonds (back)
    \foreach \a/\b/\c/\d in {0/0/1/-1, 0/0/-1/1, 1/1/2/0, 1/1/0/2, -1/-1/-2/0, -1/-1/0/-2}{%
      \draw[aveBond!42, line width=\wb pt] (\a,\b) -- (\c,\d);}
    % bright "/"-direction bonds (front)
    \foreach \a/\b/\c/\d in {0/0/1/1, 0/0/-1/-1, 1/-1/2/0, 1/-1/0/-2, -1/1/-2/0, -1/1/0/2}{%
      \draw[aveBond, line width=\wf pt] (\a,\b) -- (\c,\d);}
    % B-sublattice nodes (1st shell): hollow rings
    \foreach \p in {(1,1),(-1,-1),(1,-1),(-1,1)}{%
      \fill[avePaper] \p circle (\rb pt);
      \draw[aveNodeEdge!80, line width=\web pt] \p circle (\rb pt);}
    % A-sublattice nodes (2nd shell): solid
    \foreach \p in {(2,0),(-2,0),(0,2),(0,-2)}{%
      \fill[aveNode] \p circle (\ra pt);
      \draw[aveNodeEdge, line width=\wea pt] \p circle (\ra pt);}
    % centre A-site, largest, haloed
    \fill[aveNode!22] (0,0) circle (\rh pt);
    \fill[aveNode] (0,0) circle (\rk pt);
    \draw[aveNodeEdge, line width=\wec pt] (0,0) circle (\rk pt);
  \end{tikzpicture}%
  \endgroup}

% =====================================================================
%  DOT GRID  —  the writing surface (dots = coordinate nodes)
% =====================================================================
\ifave@iso
  % triangular / <111>-projection lattice: rectangular tile s x s*sqrt3
  % with a dot at a corner and one at the tile centre.
  \pgfdeclarepatternformonly{ave@grid}
    {\pgfpoint{-0.6pt}{-0.6pt}}{\pgfpoint{5mm}{8.6603mm}}{\pgfpoint{5mm}{8.6603mm}}{%
      \pgfpathcircle{\pgfpoint{0pt}{0pt}}{0.42pt}\pgfusepath{fill}%
      \pgfpathcircle{\pgfpoint{2.5mm}{4.3301mm}}{0.42pt}\pgfusepath{fill}}
\else
  % square 5mm dot grid
  \pgfdeclarepatternformonly{ave@grid}
    {\pgfpoint{-0.6pt}{-0.6pt}}{\pgfpoint{5mm}{5mm}}{\pgfpoint{5mm}{5mm}}{%
      \pgfpathcircle{\pgfpoint{0pt}{0pt}}{0.42pt}\pgfusepath{fill}}
\fi

\ifave@dots
  \AddToShipoutPictureBG{%
    \AtPageLowerLeft{%
      \begin{tikzpicture}
        \fill[pattern=ave@grid, pattern color=aveGrid]
          (0,0) rectangle (\paperwidth,\paperheight);
        \ifave@border
          \draw[aveGridStrong, line width=0.6pt]
            ([shift={(14mm,12mm)}]0,0)
            rectangle ([shift={(-12mm,-14mm)}]\paperwidth,\paperheight);
        \fi
      \end{tikzpicture}}}
\fi

