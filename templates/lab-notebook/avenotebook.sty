% =====================================================================
%  MASTER NOTEBOOK MODE  —  Leuchtturm A4+ style: numbered dotted pages,
%  fill-in Contents index, ownership page.  Pair with the [a4plus] option.
% =====================================================================

% per-page furniture for blank dotted pages: faint DATE/TOPIC rules at the
% top, page number in the OUTER bottom corner, tiny bond-star inner corner.
\fancypagestyle{avemaster}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyhead[L]{\sffamily\fontsize{6}{7}\selectfont\textcolor{aveFaint}{DATE}\,%
    \textcolor{aveGridStrong}{\rule[1.2pt]{34mm}{0.4pt}}}%
  \fancyhead[R]{\textcolor{aveGridStrong}{\rule[1.2pt]{46mm}{0.4pt}}\,%
    \sffamily\fontsize{6}{7}\selectfont\textcolor{aveFaint}{TOPIC}}%
  \fancyfoot[LE,RO]{\sffamily\fontsize{8.5}{10}\selectfont\textcolor{aveFaint}{\thepage}}%
  \fancyfoot[RE,LO]{\raisebox{-1pt}{\avebondstar[5]}}%
}

% page-emitting loops use plain-TeX \loop (NOT \foreach: \foreach tokenises
% its whole body, so \clearpage/\thispagestyle fire at the wrong time vs the
% output routine and pages fall back to the default style).
\newcount\ave@pgc
\newcount\ave@idxc

% \avedottedpages{<n>} — n numbered blank dotted pages in master style.
\newcommand{\avedottedpages}[1]{%
  \clearpage\pagestyle{avemaster}%
  \ave@pgc=0
  \loop\ifnum\ave@pgc<#1
    \null\newpage
    \advance\ave@pgc by 1
  \repeat}

% \aveownership — front "this notebook belongs to / if found" page.
\newcommand{\aveownership}{%
  \thispagestyle{empty}\null\vspace*{2.0cm}%
  \begin{center}\avebondstar[16]\end{center}\vspace{1.1cm}\par\noindent
  {\sffamily\fontsize{9}{12}\selectfont\textcolor{aveFaint}{\MakeUppercase{This notebook belongs to}}}\\[3mm]
  \textcolor{aveGridStrong}{\rule{\linewidth}{0.4pt}}\\[12mm]
  {\sffamily\fontsize{9}{12}\selectfont\textcolor{aveFaint}{\MakeUppercase{If found, please return to}}}\\[3mm]
  \textcolor{aveGridStrong}{\rule{\linewidth}{0.4pt}}\\[7mm]
  \textcolor{aveGridStrong}{\rule{\linewidth}{0.4pt}}\\[14mm]
  {\sffamily\fontsize{9}{12}\selectfont\textcolor{aveFaint}{%
    \begin{tabular}{@{}p{34mm}p{34mm}p{34mm}@{}}
      \MakeUppercase{Volume} & \MakeUppercase{Opened} & \MakeUppercase{Closed}\\[3mm]
      \textcolor{aveGridStrong}{\rule{30mm}{0.4pt}} &
      \textcolor{aveGridStrong}{\rule{30mm}{0.4pt}} &
      \textcolor{aveGridStrong}{\rule{30mm}{0.4pt}}\\
    \end{tabular}}}%
  \clearpage}

% one column of ruled "topic .......... page" lines (fill-in by hand).
% Drawn in TikZ at a fixed 7.4 mm pitch — deterministic, avoids the
% \par/\baselineskip drift that otherwise overflows the page.
\newcommand{\ave@indexcol}[1]{%
  \begin{minipage}[t]{0.47\linewidth}
    \begin{tikzpicture}
      \foreach \ave@r in {1,...,#1}{%
        \draw[aveGridStrong, line width=0.35pt]
          (0,{-\ave@r*7.4mm}) -- (0.80\linewidth,{-\ave@r*7.4mm});
        \draw[aveGridStrong, line width=0.35pt]
          (0.86\linewidth,{-\ave@r*7.4mm}) -- (\linewidth,{-\ave@r*7.4mm});}%
    \end{tikzpicture}%
  \end{minipage}}

\newcommand{\ave@indexheader}{%
  \noindent\raisebox{-0.4ex}{\avebondstar[8]}\hspace{0.6em}%
  {\sffamily\bfseries\fontsize{14}{16}\selectfont\textcolor{aveHead}{\MakeUppercase{Contents}}}%
  \hfill{\sffamily\fontsize{6.5}{8}\selectfont\textcolor{aveFaint}{%
    \MakeUppercase{Topic}\hspace{2em}\MakeUppercase{Page}}}%
  \par\vspace{2pt}\noindent\textcolor{aveRule}{\rule{\linewidth}{1.2pt}}\par\vspace{6mm}}

% \aveindex[<pages>]{<rows-per-column>} — fill-in Contents (default 3 pages).
\newcommand{\aveindex}[2][3]{%
  \clearpage\pagestyle{empty}%
  \ave@idxc=0
  \loop\ifnum\ave@idxc<#1
    \ave@indexheader
    \noindent\ave@indexcol{#2}\hfill\ave@indexcol{#2}%
    \newpage
    \advance\ave@idxc by 1
  \repeat}

% \aveplate{<graphic>}{<caption>} — full-bleed dark frontispiece plate. Paints
% its own black page over the grid, so it works in light OR dark notebooks.
\newcommand{\aveplate}[2]{%
  \clearpage\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[black] (current page.south west) rectangle (current page.north east);
    \node[inner sep=0pt] at (current page.center)
      {\includegraphics[width=0.92\paperwidth,height=0.80\paperheight,keepaspectratio]{#1}};
    \node[font=\sffamily\fontsize{8}{11}\selectfont, text=white!70, align=center]
      at ([yshift=-0.42\paperheight]current page.center) {\MakeUppercase{#2}};
  \end{tikzpicture}%
  \null\clearpage}

\endinput
