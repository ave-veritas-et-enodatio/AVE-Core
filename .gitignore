*.blg

# Build auxiliary files (logs, synctex, etc.) — PDFs are tracked
build/aux/

# Simulation data
data/*
simulations/*
sim_outputs/

# Canonical documentation assets — exception to sim_outputs/ ignore above.
# The K4 lattice structure render is referenced by vol_1 ch01 \includegraphics
# (line 182) and is required for downstream vol_9 builds (`make vol9` chains
# `make vol1`). Tracked so worktrees and CI builds resolve it. The
# un-ignore-then-re-ignore-then-allowlist pattern matches the data/pantheon_plus
# convention below — required because a bare `sim_outputs/` rule excludes the
# parent directory, and git cannot re-include files under an excluded parent.
!assets/sim_outputs/
assets/sim_outputs/*
!assets/sim_outputs/lattice_structure_3d.png

# Canonical external research data — explicit allowlist (override of data/* above)
# External research artifacts (not simulation outputs) tracked for reproducibility.
# Large covariance files (>5MB) routed through git-LFS per .gitattributes.
!data/pantheon_plus/
data/pantheon_plus/*
!data/pantheon_plus/README.md
!data/pantheon_plus/Pantheon+SH0ES.dat
!data/pantheon_plus/Pantheon+SH0ES_STAT+SYS.cov
!data/sdss_dr17/
data/sdss_dr17/*
!data/sdss_dr17/README.md
!data/sdss_dr17/GalaxyZoo1_DR_table2.csv.gz
!data/shamir_2022/
data/shamir_2022/*
!data/shamir_2022/README.md

#.claude/memory/
#.claude/agent-memory/
.claude/local-settings.json
.claude/worktrees/

# transient topic handoff file
manuscript/ave-kb/session/new_topic.md
build/
artifacts/

# Build logs (should not be tracked)
benchmark_output.log
build_output.log
build_verify.log
download.log
main.log
verify.log

# Compiled PDFs in manuscript dirs (should only be in build/)
manuscript/**/main.pdf

# IDE artifacts
.gemini_reply
.cursorrules

# Agent scratch / audit working files (kept local as seed corpus for a future
# custom defense-context checker: spots where an uncontextualized AI reviewer
# will misread the framework and where the source should add pre-emptive context)
.agents/
mad-review/
mad-design/
guest-session/

# tarballs archived for extraction/transfer/sharing
*.tgz
